{
  "name": "secuirty-agency-software",
  "version": "1.0.2",
  "description": "Enterprise Security Agency Platform for managing payroll, attendance, and clients.",
  "author": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev:server": "nodemon",
    "dev": "concurrently \"nodemon\" \"npm --prefix frontend run dev\"",
    "build:frontend": "npm --prefix frontend run build",
    "build": "node scripts/build.js",
    "build:win": "node scripts/build.js --win",
    "build:linux": "node scripts/build.js --linux",
    "build:mac": "node scripts/build.js --mac",
    "test": "jest --forceExit --detectOpenHandles --runInBand",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles --runInBand",
    "test:watch": "jest --watch",
    "seed": "node seed.js"
  },
  "build": {
    "appId": "com.security.agency",
    "productName": "Security Firm Management",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "frontend-dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/mysql2/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icons/win/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Security Firm Management"
    },
    "publish": {
      "provider": "github",
      "owner": "het1621",
      "repo": "security_ferm_SW"
    }
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "connect-timeout": "^1.9.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dayjs": "^1.11.21",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.3.0",
    "exceljs": "^3.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.23.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "nodemon": "^3.1.14",
    "number-to-words": "^1.2.4",
    "pdfkit": "^0.18.0",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.2",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "wait-on": "^9.0.10"
  }
}
